macros {
    sf_tog: sf_tog {
        compatible = "zmk,behavior-macro-one-param";
        #binding-cells = <1>;
        bindings = <&macro_param_1to1 &macro_param_1to2 &dep_sf_tog MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        label = "SF_TOG";
    };

    sf_kp: sf_kp {
        compatible = "zmk,behavior-macro-one-param";
        #binding-cells = <1>;
        bindings = <&macro_param_1to1 &macro_param_1to2 &dep_sf_kp MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        label = "SF_KP";
    };
};