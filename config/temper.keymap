#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define DEFAULT_1h 0
#define HNSD 2
#define HNSD_1h 3
#define NUM 4
#define NUM_1h 5
#define NAV 6
#define NAV_1h 7
#define FUN 8
#define FUN_1h 9
#define RAISE 10
#define RAISE_1h 11

&sk { quick-release; };

&lt {
    flavor = "hold-preferred";
    quick-tap-ms = <180>;
};

/ {
    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <175>;
            tapping-term-ms = <210>;
            global-quick-tap;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 20 21 22 23 24 14 30 31 32 33 34 35 25 15 5 6 16 26 27 17 7 8 18 28 29 19 9>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 10 20 21 1 11 12 2 3 4 24 14 13 23 22 30 31 32 33 34 35 25 26 28 27 29 9 8 7 6 5 15>;
        };

        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_TOG";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        hm_bak: hm_bak {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_BAK";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <170>;
            tapping-term-ms = <190>;
            global-quick-tap;
            flavor = "tap-preferred";
        };

        sf_tog: sf_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "SF_KP";
            bindings = <&none>, <&tog>;

            #binding-cells = <2>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };
    };

    combos {
        compatible = "zmk,combos";

        enter {
            bindings = <&kp ENTER>;
            key-positions = <34 31>;
            timeout-ms = <30>;
        };

        escape {
            bindings = <&kp ESC>;
            key-positions = <1 0>;
            timeout-ms = <75>;
        };

        rh-dash {
            bindings = <&kp MINUS>;
            key-positions = <8 7>;
            require-prior-idle-ms = <50>;
            layers = <0 1 5>;
        };

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <9 8>;
            timeout-ms = <75>;
            layers = <0 1 5>;
        };

        lh-dash {
            bindings = <&kp MINUS>;
            key-positions = <1 2>;
            require-prior-idle-ms = <50>;
            layers = <0 1 5>;
        };

        reset_layers {
            bindings = <&to 0>;
            key-positions = <0 9>;
            timeout-ms = <75>;
        };

        rh-apos {
            bindings = <&kp APOS>;
            key-positions = <7 18>;
            require-prior-idle-ms = <50>;
            layers = <0 1 5>;
        };

        rh-quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <8 19>;
            require-prior-idle-ms = <50>;
            layers = <0 1 5>;
        };

        rh-pipe {
            bindings = <&kp PIPE>;
            key-positions = <5 25>;
            timeout-ms = <75>;
            layers = <0 1 5>;
        };

        lh-apos {
            bindings = <&kp APOS>;
            key-positions = <2 11>;
            require-prior-idle-ms = <50>;
            layers = <0 1 5>;
        };

        lf-quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <1 10>;
            require-prior-idle-ms = <50>;
            layers = <0 1 5>;
        };

        lh-pipe {
            bindings = <&kp PIPE>;
            key-positions = <4 24>;
            timeout-ms = <75>;
            layers = <0 1 5>;
        };

        rh-forwardslash {
            bindings = <&kp SLASH>;
            key-positions = <17 26>;
            timeout-ms = <75>;
            layers = <0 1 5>;
        };

        lh-forwardslash {
            bindings = <&kp SLASH>;
            key-positions = <12 21>;
            timeout-ms = <75>;
            layers = <1 0 5>;
        };

        rh-backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <17 28>;
            timeout-ms = <75>;
            layers = <0 1 5>;
        };

        lh-backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <12 23>;
            timeout-ms = <75>;
            layers = <0 1 5>;
        };

        lh-grave {
            bindings = <&kp GRAVE>;
            key-positions = <1 12>;
            require-prior-idle-ms = <50>;
            layers = <0 1 5>;
        };

        rh-grave {
            bindings = <&kp GRAVE>;
            key-positions = <6 17>;
            require-prior-idle-ms = <50>;
            layers = <0 1 5>;
        };

        nav_jump {
            bindings = <&mo 3>;
            key-positions = <32 33>;
            slow-release;
            timeout-ms = <75>;
            layers = <0 1>;
        };

        lh_mute {
            bindings = <&kp C_MUTE>;
            key-positions = <2 22>;
            timeout-ms = <75>;
            layers = <4>;
        };

        rh_mute {
            bindings = <&kp C_MUTE>;
            key-positions = <7 27>;
            timeout-ms = <75>;
            layers = <4>;
        };

        Clear_bt {
            bindings = <&bt BT_CLR>;
            key-positions = <3 6>;
            require-prior-idle-ms = <150>;
            layers = <6>;
        };

        lh_copy {
            bindings = <&kp LC(C)>;
            key-positions = <21 22>;
            require-prior-idle-ms = <100>;
            layers = <0 1>;
        };

        rh_copy {
            bindings = <&kp LC(C)>;
            key-positions = <27 28>;
            require-prior-idle-ms = <100>;
            layers = <0 1>;
        };

        lh_paste {
            bindings = <&kp LC(V)>;
            key-positions = <22 23>;
            require-prior-idle-ms = <100>;
            layers = <0 1>;
        };

        rh_paste {
            bindings = <&kp LC(V)>;
            key-positions = <27 26>;
            require-prior-idle-ms = <100>;
            layers = <0 1>;
        };

        lh_cut {
            bindings = <&kp LC(X)>;
            key-positions = <21 23>;
            require-prior-idle-ms = <100>;
            layers = <0 1>;
        };

        rh_cut {
            bindings = <&kp LC(X)>;
            key-positions = <26 28>;
            require-prior-idle-ms = <100>;
            layers = <0 1>;
        };

        lh_undo {
            bindings = <&kp LC(Z)>;
            key-positions = <20 21>;
            require-prior-idle-ms = <100>;
            layers = <0 1>;
        };

        rh_undo {
            bindings = <&kp LC(Z)>;
            key-positions = <28 29>;
            require-prior-idle-ms = <100>;
            layers = <0 1>;
        };

        lh_redo {
            bindings = <&kp LC(Y)>;
            key-positions = <24 23>;
            require-prior-idle-ms = <100>;
            layers = <0 1>;
        };

        rh_redo {
            bindings = <&kp LC(Y)>;
            key-positions = <25 26>;
            require-prior-idle-ms = <100>;
            layers = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
  &kp Q             &kp W        &kp E           &kp R           &kp T    &kp Y  &kp U            &kp I            &kp O                &kp P
  &hm LEFT_SHIFT A  &hm LCTRL S  &hm LEFT_ALT D  &hm LEFT_GUI F  &kp G    &kp H  &hm RIGHT_GUI J  &hm RIGHT_ALT K  &hm RIGHT_CONTROL L  &hm RIGHT_SHIFT SEMI
  &kp Z             &kp X        &kp C           &kp V           &kp B    &kp N  &kp M            &kp COMMA        &kp DOT              &kp FSLH
                                 &sf_tog 3       &kp SPACE       &mo 5    &mo 5  &kp SPACE        &sf_tog 3
            >;
        };

        handsdown_neu {
            bindings = <
  &kp W  &kp F  &kp M   &kp P   &kp V     &kp FSLH   &kp DOT  &kp Q   &kp DQT  &kp APOS
  &kp R  &kp S  &kp N   &kp T   &kp B     &kp COMMA  &kp A    &kp E   &kp I    &kp H
  &kp X  &kp C  &kp L   &kp D   &kp G     &kp MINUS  &kp U    &kp O   &kp Y    &kp K
                &trans  &trans  &trans    &trans     &trans   &trans
            >;
        };

        game {
            bindings = <
  &kp TAB         &kp Q  &kp W   &kp E   &kp R     &none   &none   &none   &none  &none
  &kp LEFT_SHIFT  &kp A  &kp S   &kp D   &kp F     &none   &none   &none   &none  &none
  &kp LCTRL       &kp X  &kp M   &kp I   &none     &none   &none   &none   &none  &none
                         &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        nav {
            bindings = <
  &none  &none     &kp UP    &none      &none     &none   &none     &kp PG_UP  &none    &none
  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none     &none   &kp HOME  &kp PG_DN  &kp END  &none
  &to 0  &to 1     &to 2     &to 3      &to 4     &to 5   &to 6     &to 0      &to 0    &to 0
                   &trans    &none      &trans    &trans  &none     &trans
            >;
        };

        media {
            bindings = <
  &none  &none       &kp C_VOL_UP      &none       &none              &none            &none       &kp C_VOL_UP  &none       &none
  &none  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &none              &none            &kp C_PREV  &kp C_PP      &kp C_NEXT  &none
  &none  &none       &kp C_VOL_DN      &none       &kp PRINTSCREEN    &kp PRINTSCREEN  &none       &kp C_VOL_DN  &none       &none
                     &trans            &none       &trans             &trans           &none       &trans
            >;
        };

        raise {
            bindings = <
  &kp N1   &kp N2    &kp N3    &kp N4    &kp N5    &kp N6  &kp N7    &kp N8    &kp N9    &kp N0
  &kp TAB  &kp LBKT  &kp LBRC  &kp LPAR  &kp LT    &kp GT  &kp RPAR  &kp RBRC  &kp RBKT  &kp APOS
  &kp F1   &kp F2    &kp F3    &kp F4    &kp F5    &kp F6  &kp F7    &kp F8    &kp F9    &kp F10
                     &kp F12   &kp BSPC  &mo 3     &mo 3   &kp DEL   &kp F11
            >;
        };

        fun {
            bindings = <
  &none              &none  &kp C_BRI_INC  &bt BT_NXT   &out OUT_TOG      &out OUT_TOG    &bt BT_NXT   &kp C_BRI_UP   &none  &none
  &none              &none  &kp C_BRI_DEC  &none        &none             &none           &none        &kp C_BRI_DEC  &none  &none
  &ext_power EP_TOG  &none  &none          &none        &studio_unlock    &studio_unlock  &none        &none          &none  &ext_power EP_TOG
                            &trans         &bootloader  &trans            &trans          &bootloader  &trans
            >;
        };

        empty {
            bindings = <
  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
                &none  &none  &none    &none  &none  &none
            >;
        };
    };
};
