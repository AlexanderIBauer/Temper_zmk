#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define DEFAULT_1h 0
#define HNSD 2
#define HNSD_1h 3
#define NUM 4
#define NUM_1h 5
#define NAV 6
#define NAV_1h 7
#define FUN 8
#define FUN_1h 9
#define RAISE 10
#define RAISE_1h 11

&sk { quick-release; };

&lt {
    flavor = "hold-preferred";
    quick-tap-ms = <180>;
};

/ {
    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <170>;
            tapping-term-ms = <190>;
            global-quick-tap;
            flavor = "tap-preferred";
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 20 21 22 23 24 14 30 31 32 33 34 35 25 15 5 6 16 26 27 17 7 8 18 28 29 19 9>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 10 20 21 1 11 12 2 3 4 24 14 13 23 22 30 31 32 33 34 35 25 26 28 27 29 9 8 7 6 5 15>;
        };

        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_TOG";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };
    };

    combos {
        compatible = "zmk,combos";

        enter {
            bindings = <&kp ENTER>;
            key-positions = <34 31>;
            timeout-ms = <30>;
        };

        escape {
            bindings = <&kp ESC>;
            key-positions = <1 0>;
        };

        dash {
            bindings = <&kp MINUS>;
            key-positions = <8 7>;
            layers = <0>;
        };

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <9 8>;
            layers = <0>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <1 2>;
            layers = <0>;
        };

        reset_layers {
            bindings = <&to 0>;
            key-positions = <0 9>;
        };

        dot {
            bindings = <&kp DOT>;
            key-positions = <28 27>;
            layers = <0 3 5>;
        };

        nav_jump {
            bindings = <&mo 3>;
            key-positions = <32 33>;
            layers = <0 1>;
            slow-release;
            timeout-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &kp Q             &kp W        &kp E           &kp R           &kp T    &kp Y  &kp U            &kp I            &kp O                &kp P
  &hm LEFT_SHIFT A  &hm LCTRL S  &hm LEFT_ALT D  &hm LEFT_GUI F  &kp G    &kp H  &hm RIGHT_GUI J  &hm RIGHT_ALT K  &hm RIGHT_CONTROL L  &hm RIGHT_SHIFT SEMI
  &kp Z             &kp X        &kp C           &kp V           &kp B    &kp N  &kp M            &kp COMMA        &kp DOT              &kp FSLH
                                 &studio_unlock  &kp SPACE       &mo 5    &mo 5  &kp SPACE        &tog 3
            >;
        };

        handsdown_neu {
            bindings = <
  &kp W  &kp F  &kp M   &kp P   &kp V     &kp FSLH   &kp DOT  &kp Q   &kp DQT  &kp APOS
  &kp R  &kp S  &kp N   &kp T   &kp B     &kp COMMA  &kp A    &kp E   &kp I    &kp H
  &kp X  &kp C  &kp L   &kp D   &kp G     &kp MINUS  &kp U    &kp O   &kp Y    &kp K
                &trans  &trans  &trans    &trans     &trans   &trans
            >;
        };

        num_layer {
            bindings = <
  &kp TILDE      &kp AT    &kp LBRC  &kp RBRC  &kp PRCNT    &kp STAR             &kp N7  &kp N8  &kp N9  &kp MINUS
  &kp CARET      &kp HASH  &kp LPAR  &kp RPAR  &kp DLLR     &kp UNDER            &kp N4  &kp N5  &kp N6  &kp PLUS
  &mt PIPE AMPS  &kp LT    &kp LBKT  &kp RBKT  &kp GT       &mt BACKSLASH SLASH  &kp N1  &kp N2  &kp N3  &kp EQUAL
                           &trans    &trans    &trans       &trans               &trans  &trans
            >;
        };

        nav_layer {
            bindings = <
  &none  &none     &kp UP    &none      &none     &none   &none     &kp PG_UP  &none    &none
  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none     &none   &kp HOME  &kp PG_DN  &kp END  &none
  &to 0  &to 1     &to 2     &to 3      &to 4     &to 5   &to 6     &to 0      &to 0    &to 0
                   &none     &none      &trans    &trans  &none     &trans
            >;
        };

        fun_layer {
            bindings = <
  &trans        &kp K_MUTE    &kp K_VOL_DN  &kp K_VOL_DN  &out OUT_USB    &out OUT_BLE  &kp K_VOL_UP  &kp F8       &kp F9  &kp F12
  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans        &kp F4        &kp F5       &kp F6  &kp F11
  &bt BT_CLR    &kp C_PREV    &kp C_PP      &kp C_NEXT    &trans          &trans        &kp F1        &kp F2       &kp F3  &kp F10
                              &bootloader   &trans        &trans          &trans        &trans        &bootloader
            >;
        };

        raise {
            bindings = <
  &kp N1   &kp N2    &kp N3    &kp N4    &kp N5    &kp N6  &kp N7    &kp N8    &kp N9    &kp N0
  &kp TAB  &kp LBKT  &kp LBRC  &kp LPAR  &kp LT    &kp GT  &kp RPAR  &kp RBRC  &kp RBKT  &kp APOS
  &kp F1   &kp F2    &kp F3    &kp F4    &kp F5    &kp F6  &kp F7    &kp F8    &kp F9    &kp F10
                     &kp F12   &kp BSPC  &trans    &trans  &kp DEL   &kp F11
            >;
        };

        empty {
            bindings = <
  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
                &none  &none  &none    &none  &none  &none
            >;
        };
    };
};
